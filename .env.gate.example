# Copy to .env and set the Gate URL reachable from the workbench container.
WORKBENCH_GATE_URL=http://host.docker.internal:8000

# Optional: replace beta with a published image tag to pin that version.
# WORKBENCH_IMAGE=ghcr.io/kronosxup/nai-workbench:beta

# Optional: only when using compose.gate-network.yaml for a Gate container network.
# GATE_DOCKER_NETWORK=gate_default
