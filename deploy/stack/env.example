# 首次安装只需填写下面两项。保留英文单引号，将引号内的文字替换掉。
ADMIN_PASSWORD=''
NAI_TOKENS=''

# 已核对的版本；升级时再修改，不必第一次就研究这些选项。
WORKBENCH_IMAGE=ghcr.io/kronosxup/nai-workbench:v0.1.0-beta.5
GATE_IMAGE=nai-gate:4b0ff69

# 后台只通过本机 / SSH 隧道访问，不公开 HTTP 管理端口。
ADMIN_COOKIE_SECURE=0
# 全站允许图生图；具体用户仍需在后台开启对应 Key 权限。
ALLOW_IMG2IMG=1
# 不自动删除长期未使用的 Key。
KEY_INACTIVITY_DELETE_DAYS=0

GLOBAL_CONCURRENCY=1
KEY_CONCURRENCY=1
IMAGE_MIN_INTERVAL=15
KEY_IMAGE_MIN_INTERVAL=15
# 这是 Gate 的站点预算，不代表官方赠送额度。可在后台调整。
GLOBAL_MONTHLY_ANLAS=10000
GLOBAL_DAILY_V5=150
